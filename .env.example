# Copy to .env and set one API key. The app runs without any key using
# LLM_PROVIDER=stub, but stub results are not a model evaluation.

# --- LLM ---------------------------------------------------------------
# stub | anthropic | openrouter | google | groq | ollama
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Leave blank to use the per-provider default:
#   anthropic  -> claude-haiku-4-5
#   openrouter -> google/gemini-2.0-flash-001
#   google     -> gemini-2.0-flash
#   groq       -> llama-3.3-70b-versatile
#   ollama     -> qwen3:8b
LLM_MODEL=claude-haiku-4-5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_S=90
OLLAMA_BASE_URL=http://localhost:11434

# Published per-1M-token rates for the model in use. Left at 0, the app and the
# evaluation report show $0.0000 rather than a fabricated cost.
# Published rates for claude-haiku-4-5 (USD per million tokens).
LLM_COST_IN=1.00
LLM_COST_OUT=5.00

# --- Operating mode ----------------------------------------------------
# true serves committed fixtures instead of calling data.gov.sg. Required for
# the fully offline demo and for reproducible evaluation runs.
OFFLINE_MODE=false

# --- Retrieval ---------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# Queries whose top fused retrieval score falls below this are counted as
# out-of-corpus on the monitoring dashboard. That rate is the early warning
# that published guidance has changed and the corpus has not.
OUT_OF_CORPUS_THRESHOLD=0.012

# --- Upstreams ---------------------------------------------------------
UPSTREAM_CACHE_TTL_S=300
# Optional. Without it, hotspot counts report as unavailable rather than
# showing a fabricated number.
FIRMS_API_KEY=
